{
  "entities": {
    "CustomExplanation": {
      "title": "Custom Explanation",
      "description": "Student's custom or generated explanations for specific sociology topics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paper": { "type": "string" },
        "topic": { "type": "string" },
        "subTopic": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "paper", "topic", "subTopic", "content", "updatedAt"]
    },
    "CustomNote": {
      "title": "Custom Note",
      "description": "Student's customized notes, extra theorists, case studies, or examples for any sub-topic.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paper": { "type": "string" },
        "topic": { "type": "string" },
        "subTopic": { "type": "string" },
        "notes": { "type": "string" },
        "customTheorists": { "type": "array" },
        "customStudies": { "type": "array" },
        "customExamples": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "paper", "topic", "subTopic", "updatedAt"]
    },
    "SavedQuestion": {
      "title": "Saved Question",
      "description": "Sociology questions generated by the AI or selected by the student, along with mark schemes and model answers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paper": { "type": "string" },
        "topic": { "type": "string" },
        "questionType": { "type": "string" },
        "question": { "type": "string" },
        "markScheme": { "type": "array" },
        "modelAnswer": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "paper", "topic", "questionType", "question", "createdAt"]
    },
    "QuizScore": {
      "title": "Quiz Score",
      "description": "Student's performance and scores on quizzes and self-assessments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paper": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "answers": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "paper", "score", "totalQuestions", "createdAt"]
    }
  },
  "firestore": {
    "/custom_explanations/{explanationId}": {
      "schema": "CustomExplanation",
      "description": "Collection of textbook-style explanations saved or generated by students."
    },
    "/custom_notes/{noteId}": {
      "schema": "CustomNote",
      "description": "Collection of personalized notes, custom theorists, and case studies."
    },
    "/saved_questions/{questionId}": {
      "schema": "SavedQuestion",
      "description": "Collection of generated questions and practice materials."
    },
    "/quiz_scores/{scoreId}": {
      "schema": "QuizScore",
      "description": "Collection of students' quiz and test scores."
    }
  }
}

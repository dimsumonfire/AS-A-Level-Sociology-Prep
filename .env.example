# Your OpenRouter API key. Server-side only — never exposed to the browser.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model to use, in OpenRouter's "provider/model" form.
# Optional — defaults to google/gemini-2.5-flash.
# Examples:
#   google/gemini-2.5-flash      (fast, cheap, handles images + PDFs)
#   anthropic/claude-sonnet-4.5  (strongest written answers)
#   openai/gpt-4.1-mini
OPENROUTER_MODEL=

# The URL this app is hosted at. Used only for OpenRouter attribution headers.
APP_URL=
